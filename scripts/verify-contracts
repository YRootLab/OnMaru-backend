#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
cd "$repo_root"

python3 scripts/test/validate-r1-contract.py

tmp_dir="$(mktemp -d)"
trap 'rm -rf "$tmp_dir"' EXIT

npx -y -p @dbml/cli dbml2sql docs/database/schema.dbml --postgres >"$tmp_dir/onmaru-dbml-verify.sql"
AZIMUTT_OUTPUT_DIR="$tmp_dir" node scripts/azimutt-export.mjs

diff -u docs/database/azimutt/onmaru-schema.azimutt.sql "$tmp_dir/onmaru-schema.azimutt.sql"
diff -u docs/database/azimutt/onmaru-schema.azimutt-strict.sql "$tmp_dir/onmaru-schema.azimutt-strict.sql"
diff -u docs/database/azimutt/onmaru-schema.postgres.sql "$tmp_dir/onmaru-schema.postgres.sql"
