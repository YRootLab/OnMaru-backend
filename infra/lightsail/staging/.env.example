# Copy to .env on the Lightsail host, replace placeholders, then chmod 600 .env.
# This file belongs only to onmaru-staging. Do not copy production secrets or DB dumps.
ONMARU_SPRING_IMAGE=ghcr.io/yrootlab/onmaru-backend/spring-api:REPLACE_WITH_DEVELOP_COMMIT_SHA
ONMARU_POSTGRES_DB=onmaru_staging
ONMARU_POSTGRES_ADMIN_USER=onmaru_bootstrap
ONMARU_POSTGRES_ADMIN_PASSWORD=REPLACE_WITH_UNIQUE_RANDOM_SECRET
ONMARU_DB_RUNTIME_USER=onmaru_runtime_login
ONMARU_DB_RUNTIME_PASSWORD=REPLACE_WITH_UNIQUE_RANDOM_SECRET
ONMARU_DB_MIGRATION_USER=onmaru_migration_login
ONMARU_DB_MIGRATION_PASSWORD=REPLACE_WITH_UNIQUE_RANDOM_SECRET
ONMARU_DB_READONLY_USER=onmaru_readonly_login
ONMARU_DB_READONLY_PASSWORD=REPLACE_WITH_UNIQUE_RANDOM_SECRET
ONMARU_DB_BACKUP_USER=onmaru_backup_login
ONMARU_DB_BACKUP_PASSWORD=REPLACE_WITH_UNIQUE_RANDOM_SECRET
ONMARU_CORS_ALLOWED_ORIGINS=https://staging.onmaru.site,http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3004,http://localhost:3005,http://localhost:3006,http://localhost:3007,http://localhost:3008
ONMARU_OAUTH_KAKAO_CLIENTID=REPLACE_WITH_STAGING_KAKAO_REST_API_KEY
ONMARU_OAUTH_KAKAO_REDIRECTURI=https://staging-api.onmaru.site/auth/kakao/callback
ONMARU_OAUTH_KAKAO_FRONTENDBASEURL=https://staging.onmaru.site
ONMARU_SECRET_TOURAPI_SERVICE_KEY_CURRENT=REPLACE_WITH_STAGING_TOURAPI_KEY
ONMARU_SECRET_ODII_SERVICE_KEY_CURRENT=REPLACE_WITH_STAGING_ODII_KEY
ONMARU_SECRET_GEMINI_API_KEY_CURRENT=REPLACE_WITH_STAGING_GEMINI_KEY
ONMARU_SECRET_OAUTH_CLIENT_SECRET_CURRENT=REPLACE_WITH_UNIQUE_RANDOM_SECRET
ONMARU_SECRET_ADMIN_JWT_SIGNING_KEY_CURRENT=REPLACE_WITH_UNIQUE_RANDOM_SECRET
ONMARU_SECRET_ADMIN_CURSOR_SIGNING_KEY_CURRENT=REPLACE_WITH_UNIQUE_RANDOM_SECRET
ONMARU_SECRET_OTLP_EXPORTER_TOKEN_CURRENT=REPLACE_WITH_UNIQUE_RANDOM_SECRET
ONMARU_SECRET_MODERATION_OPERATOR_TOKEN_CURRENT=REPLACE_WITH_UNIQUE_RANDOM_SECRET
ONMARU_SECRET_DATALAB_OPERATIONS_TOKEN_CURRENT=REPLACE_WITH_UNIQUE_RANDOM_SECRET
ONMARU_DATALAB_VISITOR_SERVICE_KEY=REPLACE_WITH_STAGING_DATALAB_KEY
