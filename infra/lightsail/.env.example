# Copy this file to .env on the server, replace every placeholder, then chmod 600 .env.
# Never commit the populated .env file or paste its contents into chat/logs.

# Use a commit SHA tag from the existing Staging Deploy GHCR workflow.
ONMARU_SPRING_IMAGE=ghcr.io/yrootlab/onmaru-backend/spring-api:REPLACE_WITH_COMMIT_SHA

# First start with the HTTP-only ACME bootstrap config. Switch to ./nginx/site.conf after certbot succeeds.
NGINX_SITE_CONFIG=./nginx/bootstrap.conf
# The staging virtual host stays on HTTP 503 until DNS and its own certificate exist.
NGINX_STAGING_SITE_CONFIG=./nginx/staging-bootstrap.conf
LETSENCRYPT_EMAIL=REPLACE_WITH_A_REAL_EMAIL

# PostgreSQL bootstrap administrator: initialization only, never used by Spring.
ONMARU_POSTGRES_DB=onmaru
ONMARU_POSTGRES_ADMIN_USER=onmaru_bootstrap
ONMARU_POSTGRES_ADMIN_PASSWORD=REPLACE_WITH_64_HEX_CHAR_RANDOM_SECRET

# Application and operations login accounts. Role grants follow V001's NOLOGIN group roles.
ONMARU_DB_RUNTIME_USER=onmaru_runtime_login
ONMARU_DB_RUNTIME_PASSWORD=REPLACE_WITH_64_HEX_CHAR_RANDOM_SECRET
ONMARU_DB_MIGRATION_USER=onmaru_migration_login
ONMARU_DB_MIGRATION_PASSWORD=REPLACE_WITH_64_HEX_CHAR_RANDOM_SECRET
ONMARU_DB_READONLY_USER=onmaru_readonly_login
ONMARU_DB_READONLY_PASSWORD=REPLACE_WITH_64_HEX_CHAR_RANDOM_SECRET
ONMARU_DB_BACKUP_USER=onmaru_backup_login
ONMARU_DB_BACKUP_PASSWORD=REPLACE_WITH_64_HEX_CHAR_RANDOM_SECRET

# Production FE origins only. Localhost and Render origins are intentionally excluded from AWS.
ONMARU_CORS_ALLOWED_ORIGINS=https://onmaru.site,https://www.onmaru.site

# Kakao Developers REST API key (not the JavaScript key).
ONMARU_OAUTH_KAKAO_CLIENTID=REPLACE_WITH_KAKAO_REST_API_KEY
ONMARU_OAUTH_KAKAO_REDIRECTURI=https://api.onmaru.site/auth/kakao/callback
ONMARU_OAUTH_KAKAO_FRONTENDBASEURL=https://www.onmaru.site

# Every currently required Spring environment secret. Generate unique random values for signing/operator tokens.
ONMARU_SECRET_TOURAPI_SERVICE_KEY_CURRENT=REPLACE_WITH_TOURAPI_SERVICE_KEY
ONMARU_SECRET_ODII_SERVICE_KEY_CURRENT=REPLACE_WITH_ODII_SERVICE_KEY
ONMARU_SECRET_GEMINI_API_KEY_CURRENT=REPLACE_WITH_GEMINI_API_KEY
ONMARU_SECRET_OAUTH_CLIENT_SECRET_CURRENT=REPLACE_WITH_64_HEX_CHAR_RANDOM_SECRET
ONMARU_SECRET_ADMIN_JWT_SIGNING_KEY_CURRENT=REPLACE_WITH_64_HEX_CHAR_RANDOM_SECRET
ONMARU_SECRET_ADMIN_CURSOR_SIGNING_KEY_CURRENT=REPLACE_WITH_64_HEX_CHAR_RANDOM_SECRET
ONMARU_SECRET_OTLP_EXPORTER_TOKEN_CURRENT=REPLACE_WITH_64_HEX_CHAR_RANDOM_SECRET
ONMARU_SECRET_MODERATION_OPERATOR_TOKEN_CURRENT=REPLACE_WITH_64_HEX_CHAR_RANDOM_SECRET
ONMARU_SECRET_DATALAB_OPERATIONS_TOKEN_CURRENT=REPLACE_WITH_64_HEX_CHAR_RANDOM_SECRET
ONMARU_DATALAB_VISITOR_SERVICE_KEY=REPLACE_WITH_DATALAB_VISITOR_SERVICE_KEY
