          },
          {
            "name": "north",
            "in": "query",
            "schema": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            "required": false
          },
          {
            "name": "radiusMeters",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 100,
              "maximum": 20000,
              "default": 5000
            },
            "required": false
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 20
            },
            "required": false
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "required": false
          }
        ],
        "description": "ALL forbids spatial parameters; REGION requires only regionCode; NEARBY requires lat/lng and optional radius; VIEWPORT requires west/south/east/north, ordered bounds, each span <=40km. New filters reset cursor. All sorts createdAt DESC,id DESC. Cursor signed/encrypted or opaque, expiry 10min, scope/limit bound. See api-contract.md."
      }
    },
