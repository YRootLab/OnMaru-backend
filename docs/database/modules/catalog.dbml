Enum catalog_region_level {
  SIDO
  SIGUNGU
}

Enum catalog_dataset_status {
  STAGING
  READY
  PUBLISHED
  FAILED
}

Enum catalog_place_status {
  ACTIVE
  HIDDEN
  DELETED
}

Enum content_tag_source {
  GENERATED
  PINNED
  OPERATOR
}

Enum content_tag_override_target {
  PLACE
  ODII_STORY
}

Enum content_tag_override_action {
  PIN
  HIDE
}

Table catalog_regions [headercolor: #59A14F] {
  id uuid [pk]
  parent_id uuid
  code varchar [not null, unique]
  name varchar [not null]
  level catalog_region_level [not null]
  active boolean [not null]
}

Table catalog_region_source_codes [headercolor: #59A14F] {
  provider varchar [not null]
  dataset varchar [not null]
  source_code varchar [not null]
  valid_from date [not null]
  region_id uuid [not null]
  valid_to date

  Indexes {
    (provider, dataset, source_code, valid_from) [pk]
    region_id
  }
}

Table catalog_region_boundaries [headercolor: #59A14F] {
  boundary_revision varchar [not null]
  region_id uuid [not null]
  geometry geometry [not null, note: 'PostGIS MultiPolygon(4326)']
  source_name varchar [not null]
  rights_note text [not null]
  observed_at timestamptz [not null]

  Indexes {
    (boundary_revision, region_id) [pk]
    geometry [type: gist]
  }
}

Table catalog_dataset_revisions [headercolor: #59A14F] {
  id uuid [pk]
  dataset varchar [not null]
  status catalog_dataset_status [not null]
  base_revision_id uuid
  source_observed_at timestamptz
  fetched_at timestamptz [not null]
  published_at timestamptz

  Indexes {
    (dataset, id) [unique]
    (dataset, status)
  }
}

Table catalog_active_datasets [headercolor: #59A14F] {
  dataset varchar [pk]
  revision_id uuid [not null]
  activated_at timestamptz [not null]
}

Table catalog_place_identity [headercolor: #59A14F] {
  id uuid [pk]
  created_at timestamptz [not null]
}

Table catalog_place_public_ids [headercolor: #59A14F] {
  public_id varchar [pk, note: 'Stable FE-visible p-lowercase-kebab-case ID']
  place_id uuid [not null, unique]
  created_at timestamptz [not null]
}

Table catalog_external_places [headercolor: #59A14F] {
  provider varchar [not null, note: 'MVP: KAKAO']
  external_id varchar(128) [not null]
  place_id uuid [not null, unique]
  public_place_id varchar [not null, unique, note: 'Opaque p-ext-{32 lowercase hex}']
  name varchar(100) [not null]
  region_code varchar [not null, note: 'Canonical kr-* or kr-unassigned']
  location geography [not null, note: 'PostGIS Point(4326)']
  provenance varchar [not null, note: 'CLIENT_ASSERTED']
  created_at timestamptz [not null]

  Indexes {
    (provider, external_id) [pk]
    location [type: gist]
  }
}

Table catalog_place_sources [headercolor: #59A14F] {
  id uuid [pk]
  place_id uuid [not null]
  provider varchar [not null]
  dataset varchar [not null]
  external_id varchar [not null, note: 'KTO Korean contentid, future source id, or normalized source key']
  language varchar [not null]
  fetched_at timestamptz [not null]
  payload_hash varchar

  Indexes {
    (provider, dataset, external_id, language) [unique]
    place_id
  }
}

Table catalog_place_versions [headercolor: #59A14F] {
  revision_id uuid [not null]
  place_id uuid [not null]
  source_ref_id uuid [not null]
  region_id uuid
  name varchar [not null]
  category varchar [not null]
  address text
  location geography [note: 'PostGIS Point(4326)']
  overview text
  visit_review_eligible boolean [not null]
  status catalog_place_status [not null]
  normalized_hash varchar [not null]

  Indexes {
    (revision_id, place_id) [pk]
    region_id
    location [type: gist]
    (status, category)
  }
}

// Information-mode map read projections. These tables are built from a staged
// catalog revision and become visible with catalog_active_datasets in one
// transaction. location_geom is geometry for bbox/GiST work; source location
// remains geography for distance calculations.
Table map_place_read_projection [headercolor: #4E79A7] {
  revision_id uuid [not null]
  place_id uuid [not null]
  public_id varchar [not null]
  name varchar [not null]
  normalized_name varchar [not null]
  status catalog_place_status [not null]
  location_geom geometry [not null, note: 'PostGIS Point(4326), WGS84 geometry for bbox queries']
  sido_code varchar
  sigungu_code varchar
  eupmyeondong_code varchar
  display_category varchar [not null]
  thumbnail_url text
  summary text
  sort_key varchar [not null]

  Indexes {
    (revision_id, place_id) [pk]
    (revision_id, public_id) [unique]
    (revision_id, sigungu_code, sort_key, place_id)
    (revision_id, sort_key, place_id)
    (revision_id, status, display_category, sort_key, place_id)
    location_geom [type: gist]
  }
}

Table map_place_category_projection [headercolor: #4E79A7] {
  revision_id uuid [not null]
  place_id uuid [not null]
  canonical_category varchar [not null]

  Indexes {
    (revision_id, place_id, canonical_category) [pk]
    (revision_id, canonical_category, place_id)
  }
}

Table map_scope_count_projection [headercolor: #4E79A7] {
  revision_id uuid [not null]
  scope_type varchar [not null, note: 'DISTRICT or REGION']
  region_code varchar [not null]
  canonical_category varchar [not null]
  place_count int [not null]

  Indexes {
    (revision_id, scope_type, region_code, canonical_category) [pk]
  }
}

Table map_projection_publications [headercolor: #4E79A7] {
  revision_id uuid [not null]
  projection_name varchar [not null]
  mapping_version varchar [not null]
  row_count int [not null]
  checksum varchar [not null]
  published_at timestamptz [not null]
  status catalog_dataset_status [not null]

  Indexes {
    (revision_id, projection_name) [pk]
  }
}

Table catalog_kto_korean_content_versions [headercolor: #59A14F] {
  revision_id uuid [not null]
  source_ref_id uuid [not null]
  contentid varchar [not null]
  contenttypeid varchar
  title varchar [not null]
  addr1 text
  addr2 text
  zipcode varchar
  areacode varchar
  sigungucode varchar
  cat1 varchar
  cat2 varchar
  cat3 varchar
  lcls_systm1 varchar
  lcls_systm2 varchar
  lcls_systm3 varchar
  firstimage text
  firstimage2 text
  cpyrht_div_cd varchar
  mapx numeric
  mapy numeric
  mlevel varchar
  tel varchar
  createdtime varchar
  modifiedtime varchar
  showflag varchar
  raw_hash varchar [not null]

  Indexes {
    (revision_id, source_ref_id) [pk]
    contentid
    (areacode, sigungucode)
    (cat1, cat2, cat3)
  }
}

Table catalog_kto_korean_intro_versions [headercolor: #59A14F] {
  revision_id uuid [not null]
  source_ref_id uuid [not null]
  heritage1 varchar
  heritage2 varchar
  heritage3 varchar
  infocenter text
  opendate text
  restdate text
  expguide text
  expagerange text
  accomcount text
  useseason text
  usetime text
  parking text
  chkbabycarriage text
  chkpet text
  chkcreditcard text
  raw_hash varchar [not null]

  Indexes {
    (revision_id, source_ref_id) [pk]
  }
}

Table catalog_kto_korean_info_versions [headercolor: #59A14F] {
  revision_id uuid [not null]
  source_ref_id uuid [not null]
  serialnum varchar [not null]
  infoname varchar
  infotext text
  fldgubun varchar
  raw_hash varchar [not null]

  Indexes {
    (revision_id, source_ref_id, serialnum) [pk]
  }
}

Table catalog_place_image_versions [headercolor: #59A14F] {
  revision_id uuid [not null]
  place_id uuid [not null]
  position int [not null]
  origin_img_url text [not null]
  small_image_url text
  image_name varchar
  source_ref_id uuid [not null]
  rights_note text

  Indexes {
    (revision_id, place_id, position) [pk]
    source_ref_id
  }
}

Table catalog_hanok_detail_versions [headercolor: #59A14F] {
  revision_id uuid [not null]
  place_id uuid [not null]
  type varchar
  hours text
  parking text
  homepage text
  source_ref_id uuid [not null]

  Indexes {
    (revision_id, place_id) [pk]
  }
}

Table catalog_place_content_tag_versions [headercolor: #59A14F] {
  revision_id uuid [not null]
  place_id uuid [not null]
  position int [not null]
  label varchar [not null]
  score numeric [not null]
  source content_tag_source [not null]
  algorithm_version varchar [not null]
  source_hash varchar [not null]
  generated_at timestamptz [not null]

  Indexes {
    (revision_id, place_id, position) [pk]
    (revision_id, place_id, label) [unique]
    (label, revision_id)
  }
}

Table content_tag_overrides [headercolor: #59A14F] {
  id uuid [pk]
  target_type content_tag_override_target [not null]
  target_id uuid [not null]
  label varchar [not null]
  action content_tag_override_action [not null]
  reason text
  created_by uuid
  created_at timestamptz [not null]
  expires_at timestamptz

  Indexes {
    (target_type, target_id, label, action) [unique]
    (target_type, target_id)
  }
}

TableGroup catalog [color: #59A14F, note: 'Canonical places, administrative regions, Korean TourAPI source versions, images, and published dataset pointers.'] {
  catalog_regions
  catalog_region_source_codes
  catalog_region_boundaries
  catalog_dataset_revisions
  catalog_active_datasets
  catalog_place_identity
  catalog_place_sources
  catalog_place_versions
  catalog_kto_korean_content_versions
  catalog_kto_korean_intro_versions
  catalog_kto_korean_info_versions
  catalog_place_image_versions
  catalog_hanok_detail_versions
  catalog_place_content_tag_versions
  map_place_read_projection
  map_place_category_projection
  map_scope_count_projection
  map_projection_publications
  content_tag_overrides
}

Ref: catalog_regions.parent_id >? catalog_regions.id
Ref: catalog_region_source_codes.region_id > catalog_regions.id
Ref: catalog_region_boundaries.region_id > catalog_regions.id
Ref: catalog_dataset_revisions.base_revision_id >? catalog_dataset_revisions.id
Ref: catalog_active_datasets.revision_id > catalog_dataset_revisions.id
Ref: catalog_place_sources.place_id > catalog_place_identity.id
Ref: catalog_place_versions.revision_id > catalog_dataset_revisions.id
Ref: catalog_place_versions.place_id > catalog_place_identity.id
Ref: catalog_place_versions.source_ref_id > catalog_place_sources.id
Ref: catalog_place_versions.region_id >? catalog_regions.id
Ref: catalog_kto_korean_content_versions.revision_id > catalog_dataset_revisions.id
Ref: catalog_kto_korean_content_versions.source_ref_id > catalog_place_sources.id
Ref: catalog_kto_korean_intro_versions.revision_id > catalog_dataset_revisions.id
Ref: catalog_kto_korean_intro_versions.source_ref_id > catalog_place_sources.id
Ref: catalog_kto_korean_info_versions.revision_id > catalog_dataset_revisions.id
Ref: catalog_kto_korean_info_versions.source_ref_id > catalog_place_sources.id
Ref: catalog_place_image_versions.revision_id > catalog_dataset_revisions.id
Ref: catalog_place_image_versions.place_id > catalog_place_identity.id
Ref: catalog_place_image_versions.source_ref_id > catalog_place_sources.id
Ref: catalog_hanok_detail_versions.revision_id > catalog_dataset_revisions.id
Ref: catalog_hanok_detail_versions.place_id > catalog_place_identity.id
Ref: catalog_hanok_detail_versions.source_ref_id > catalog_place_sources.id
Ref: catalog_place_content_tag_versions.(revision_id, place_id) > catalog_place_versions.(revision_id, place_id)
Ref: map_place_read_projection.(revision_id, place_id) > catalog_place_versions.(revision_id, place_id)
Ref: map_place_category_projection.(revision_id, place_id) > catalog_place_versions.(revision_id, place_id)
Ref: map_scope_count_projection.revision_id > catalog_dataset_revisions.id
Ref: map_projection_publications.revision_id > catalog_dataset_revisions.id
// V047 selected discovery is independent of legacy catalog_active_datasets.
Table selected_discovery_runs [headercolor: #59A14F] {
  id uuid [pk]
  due_at timestamp [not null, unique]
  status varchar [not null]
  detail_requests int [not null, default: 0]
  failure_code varchar
  started_at timestamp [not null]
  finished_at timestamp
}

Table selected_discovery_checkpoints [headercolor: #59A14F] {
  run_id uuid [not null, ref: > selected_discovery_runs.id]
  operation varchar [not null]
  filter_value varchar [not null]
  page_number int [not null]
  received int [not null]
  expected int [not null]
  candidate_count int [not null]
  quarantine_count int [not null]
  indexes { (run_id, operation, filter_value, page_number) [pk] }
}

Table selected_discovery_revisions [headercolor: #59A14F] {
  id uuid [pk, ref: > selected_discovery_runs.id]
  base_revision_id uuid [ref: > selected_discovery_revisions.id]
  status varchar [not null]
  policy_version varchar [not null]
  hash_schema_version varchar [not null]
  added_count int [not null]
  changed_count int [not null]
  unchanged_count int [not null]
  missing_count int [not null]
  quarantine_count int [not null]
  approved_count int [not null]
  detail_requests int [not null]
  counts_by_region jsonb [not null]
  counts_by_role jsonb [not null]
  created_at timestamp [not null]
  published_at timestamp
}

Table selected_discovery_candidates [headercolor: #59A14F] {
  revision_id uuid [not null, ref: > selected_discovery_revisions.id]
  content_id varchar [not null]
  raw jsonb [not null]
  list_hash char(64) [not null]
  detail_hash char(64) [not null]
  hash_schema_version varchar [not null]
  policy_version varchar [not null]
  decision varchar [not null]
  role varchar
  reason_code varchar [not null]
  diff_status varchar [not null]
  modifiedtime varchar
  indexes { (revision_id, content_id) [pk] }
}

Table selected_discovery_quarantines [headercolor: #59A14F] {
  id uuid [pk]
  revision_id uuid [not null, ref: > selected_discovery_revisions.id]
  content_id varchar
  reason_code varchar [not null]
  decision varchar [not null]
  policy_reason varchar [not null]
  raw jsonb [not null]
}

Table selected_discovery_approvals [headercolor: #59A14F] {
  content_id varchar [pk]
  list_hash char(64) [not null]
  detail_hash char(64) [not null]
  role varchar [not null]
  source_fingerprint text [not null]
  detail_reviewed boolean [not null]
  rights_reviewed boolean [not null]
  evidence_ref text [not null]
  approved_by varchar [not null]
  approved_at timestamp [not null]
}

Table selected_discovery_approval_audit [headercolor: #59A14F] {
  id uuid [pk]
  content_id varchar [not null]
  action varchar [not null]
  actor varchar [not null]
  list_hash char(64)
  detail_hash char(64)
  evidence_ref text
  recorded_at timestamp [not null]
}

Table selected_discovery_public_items [headercolor: #59A14F] {
  revision_id uuid [not null, ref: > selected_discovery_revisions.id]
  content_id varchar [not null]
  place_id uuid [not null]
  role varchar [not null]
  region_code varchar
  raw jsonb [not null]
  indexes {
    (revision_id, content_id) [pk]
    (revision_id, place_id) [unique]
  }
}

Table selected_discovery_active [headercolor: #59A14F] {
  singleton boolean [pk]
  revision_id uuid [not null, ref: > selected_discovery_revisions.id]
  activated_at timestamp [not null]
}
