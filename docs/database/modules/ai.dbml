Table ai_documents [headercolor: #BAB0AC] {
  document_id uuid [not null]
  revision varchar [not null]
  content_hash varchar [not null]
  active boolean [not null]
  source_type varchar [not null]
  source_ref varchar [not null]
  metadata jsonb

  Indexes {
    (document_id, revision) [pk]
    (source_type, source_ref)
  }
}

Table ai_chunks [headercolor: #BAB0AC] {
  chunk_id uuid [pk]
  document_id uuid [not null]
  revision varchar [not null]
  position int [not null]
  text text [not null]
  offsets jsonb

  Indexes {
    (document_id, revision, position) [unique]
  }
}

Table ai_embeddings [headercolor: #BAB0AC] {
  chunk_id uuid [not null]
  embedding_profile_id varchar [not null]
  vector vector [note: 'pgvector only after optional RAG approval']

  Indexes {
    (chunk_id, embedding_profile_id) [pk]
  }
}

TableGroup ai [color: #BAB0AC, note: 'Optional RAG corpus owned by AI migration/role. Not part of MVP writes.'] {
  ai_documents
  ai_chunks
  ai_embeddings
}

Ref: ai_chunks.(document_id, revision) > ai_documents.(document_id, revision)
Ref: ai_embeddings.chunk_id > ai_chunks.chunk_id
