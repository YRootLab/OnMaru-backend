{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onmaru.example/contracts/kcontents-extraction-v1",
  "title": "K-Contents evidence extraction v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["resultStatus", "candidates"],
  "properties": {
    "resultStatus": {"enum": ["MATCH", "NO_MATCH", "UNCERTAIN"]},
    "candidates": {"type": "array", "items": {"$ref": "#/$defs/candidate"}},
    "ambiguityReason": {"type": ["string", "null"]},
    "nextSearchAt": {"type": "string", "format": "date-time", "description": "Only for NO_MATCH"}
  },
  "allOf": [
    {"if": {"properties": {"resultStatus": {"const": "NO_MATCH"}}},
     "then": {"properties": {"candidates": {"maxItems": 0}}},
     "else": {"not": {"required": ["nextSearchAt"]}}},
    {"if": {"properties": {"resultStatus": {"const": "MATCH"}}},
     "then": {"properties": {"candidates": {"minItems": 1}}}}
  ],
  "$defs": {
    "claim": {
      "type": "object", "additionalProperties": false,
      "required": ["evidenceId", "quote"],
      "properties": {"evidenceId": {"type": "string", "format": "uuid"}, "quote": {"type": "string", "minLength": 1}}
    },
    "tag": {
      "type": "object", "additionalProperties": false,
      "required": ["rawLabel", "scope", "groupHint", "evidenceId", "quote"],
      "properties": {
        "rawLabel": {"type": "string", "minLength": 1},
        "scope": {"enum": ["WORK_TAG", "RELATION_TAG"]},
        "groupHint": {"enum": ["WORK_GENRE", "WORK_THEME", "RELATION_CONTEXT"]},
        "evidenceId": {"type": "string", "format": "uuid"},
        "quote": {"type": "string", "minLength": 1}
      }
    },
    "summary": {
      "type": "object", "additionalProperties": false,
      "required": ["scope", "text", "evidenceId", "quote"],
      "properties": {
        "scope": {"enum": ["WORK", "RELATION"]},
        "text": {"type": "string", "minLength": 1, "maxLength": 500},
        "evidenceId": {"type": "string", "format": "uuid"},
        "quote": {"type": "string", "minLength": 1}
      }
    },
    "candidate": {
      "type": "object", "additionalProperties": false,
      "required": ["title", "workType", "placeId", "placeName", "region", "relationType", "evidence", "tags", "summaries"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "workType": {"enum": ["DRAMA", "MOVIE", "VARIETY", "MUSIC_VIDEO"]},
        "releaseYear": {"type": ["integer", "null"], "minimum": 1895, "maximum": 2200},
        "seasonKey": {"type": ["string", "null"]},
        "aliases": {"type": "array", "items": {"type": "string"}},
        "placeId": {"type": "string", "format": "uuid"},
        "placeName": {"type": "string", "minLength": 1},
        "region": {"type": "string", "minLength": 1},
        "relationType": {"const": "FILMING_LOCATION"},
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/claim"}},
        "tags": {"type": "array", "items": {"$ref": "#/$defs/tag"}},
        "summaries": {"type": "array", "items": {"$ref": "#/$defs/summary"}}
      }
    }
  }
}
