{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onmaru.local/contracts/journey-sse-event.v1.3.schema.json",
  "title": "OnMaru parsed journey SSE frame v1.3",
  "description": "The client parses id/event/data from text/event-stream, then validates this envelope. reset has no replay sequence.",
  "oneOf": [
    {
      "$ref": "#/$defs/stage"
    },
    {
      "$ref": "#/$defs/textDelta"
    },
    {
      "$ref": "#/$defs/terminal"
    },
    {
      "$ref": "#/$defs/heartbeat"
    },
    {
      "$ref": "#/$defs/reset"
    },
    {
      "$ref": "#/$defs/authClosed"
    }
  ],
  "$defs": {
    "textDelta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "event",
        "data"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$",
          "description": "Spring-assigned per-run sequence; must equal data.sequence."
        },
        "event": {
          "const": "run.text.delta"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schemaVersion",
            "runId",
            "sequence",
            "text"
          ],
          "properties": {
            "schemaVersion": {
              "const": "1.3"
            },
            "runId": {
              "type": "string",
              "format": "uuid"
            },
            "sequence": {
              "type": "integer",
              "minimum": 1,
              "description": "Equals SSE id; increments for each newly persisted public event."
            },
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          }
        }
      }
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "event",
        "data"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$",
          "description": "Spring-assigned per-run sequence; must equal data.sequence."
        },
        "event": {
          "const": "run.stage"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schemaVersion",
            "runId",
            "sequence",
            "status",
            "stage"
          ],
          "properties": {
            "schemaVersion": {
              "const": "1.3"
            },
            "runId": {
              "type": "string",
              "format": "uuid"
            },
            "sequence": {
              "type": "integer",
              "minimum": 1,
              "description": "Equals SSE id and advances only when public run stage changes."
            },
            "status": {
              "enum": [
                "QUEUED",
                "RUNNING"
              ]
            },
            "stage": {
              "enum": [
                "INTERPRETING",
                "RETRIEVING",
                "SELECTING_EVIDENCE",
                "GENERATING",
                "VALIDATING",
                "PERSISTING",
                null
              ],
              "description": "Only a stage actually reached is emitted; skipped stages are not synthesized."
            }
          }
        }
      }
    },
    "terminal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "event",
        "data"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$",
          "description": "Spring-assigned per-run sequence; must equal data.sequence."
        },
        "event": {
          "const": "run.terminal"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schemaVersion",
            "runId",
            "sequence",
            "status",
            "outcome"
          ],
          "properties": {
            "schemaVersion": {
              "const": "1.3"
            },
            "runId": {
              "type": "string",
              "format": "uuid"
            },
            "sequence": {
              "type": "integer",
              "minimum": 1,
              "description": "Equals SSE id and terminal RunSnapshot.sequence."
            },
            "status": {
              "enum": [
                "COMPLETED",
                "FAILED",
                "CANCELLED"
              ]
            },
            "outcome": {
              "enum": [
                "INITIAL_BOARD",
                "PROPOSAL",
                "CLARIFICATION_REQUIRED",
                "NO_RESULTS",
                null
              ]
            },
            "errorCode": {
              "type": "string"
            }
          }
        }
      }
    },
    "heartbeat": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "event",
        "data"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$",
          "description": "Current sequence only; heartbeat does not increment the run sequence."
        },
        "event": {
          "const": "heartbeat"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schemaVersion",
            "runId",
            "sequence"
          ],
          "properties": {
            "schemaVersion": {
              "const": "1.3"
            },
            "runId": {
              "type": "string",
              "format": "uuid"
            },
            "sequence": {
              "type": "integer",
              "minimum": 0,
              "description": "Current run sequence; equals SSE id and may be 0 before first event."
            }
          }
        }
      }
    },
    "reset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event",
        "data"
      ],
      "properties": {
        "event": {
          "const": "reset"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schemaVersion",
            "runId"
          ],
          "properties": {
            "schemaVersion": {
              "const": "1.3"
            },
            "runId": {
              "type": "string",
              "format": "uuid"
            }
          }
        }
      }
    },
    "authClosed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event",
        "data"
      ],
      "properties": {
        "event": {
          "const": "auth_closed"
        },
        "data": {
          "const": 0
        }
      }
    }
  }
}
