{
  "name": "ranking-rate-limited",
  "request": {
    "method": "PUT",
    "path": "/api/v1/me/stamp-ranking",
    "body": {"participating": true}
  },
  "response": {
    "status": 429,
    "schema": "ApiError",
    "headers": {"Cache-Control": "no-store", "Retry-After": "5"},
    "body": {
      "schemaVersion": "1.3",
      "code": "RATE_LIMITED",
      "message": "Wait before joining the ranking again",
      "requestId": "request-ranking-429",
      "details": {"retryAfterSeconds": 5}
    }
  }
}
