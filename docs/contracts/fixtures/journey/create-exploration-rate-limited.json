{
  "name": "create-exploration-rate-limited",
  "description": "Journey AI 사용량 제한은 기존 오류 필드를 유지하고 FE 호환 classification/status를 반환한다.",
  "request": {
    "method": "POST",
    "path": "/api/v1/explorations",
    "headers": {
      "Idempotency-Key": "31111111-1111-4111-8111-111111111111",
      "X-CSRF-TOKEN": "csrf-fixture-token-123456"
    },
    "body": { "query": "서울 한옥 여행", "locale": "ko-KR", "regionCode": "kr-11-seoul" }
  },
  "response": {
    "status": 429,
    "schema": "Error",
    "headers": { "Retry-After": "30", "Cache-Control": "no-store" },
    "body": {
      "schemaVersion": "1.2",
      "code": "RATE_LIMITED",
      "message": "Too many requests",
      "requestId": "req-journey-quota",
      "details": { "retryAfterMs": 30000 },
      "classification": "RATE_LIMITED",
      "status": 429
    }
  }
}
