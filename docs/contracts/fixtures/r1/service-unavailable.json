{
  "name": "service-unavailable",
  "description": "Temporary catalog read failures keep the public error envelope stable.",
  "request": {
    "method": "GET",
    "path": "/api/v1/hanoks",
    "query": {
      "limit": 20
    }
  },
  "response": {
    "status": 503,
    "schema": "Error",
    "body": {
