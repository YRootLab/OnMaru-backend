{
  "openapi": "3.1.0",
  "info": {
    "title": "OnMaru Visit Reviews - proposal",
    "version": "1.2.0",
    "description": "Separate from historical warmth. Current map contract uses administrative-region aggregation and explicit ALL or REGION review lists. Implementation and FE fixtures pending."
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "paths": {
    "/visit-review-regions": {
      "get": {
        "operationId": "listVisitReviewRegions",
        "parameters": [
          { "name": "parentRegionCode", "in": "query", "schema": { "type": "string" }, "required": false }
        ],
        "responses": {
          "200": { "description": "Region review counts", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RegionCountPage" } } } },
          "400": { "description": "Invalid or leaf parent", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "503": { "description": "Service unavailable", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/regions/resolve": {
      "get": {
        "operationId": "resolveRegion",
        "parameters": [
          { "name": "lat", "in": "query", "schema": { "type": "number", "minimum": -90, "maximum": 90 }, "required": true },
          { "name": "lng", "in": "query", "schema": { "type": "number", "minimum": -180, "maximum": 180 }, "required": true }
        ],
        "responses": {
          "200": { "description": "Candidate administrative regions; no-store", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RegionResolution" } } } },
          "400": { "description": "Invalid coordinates", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "503": { "description": "Service unavailable", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
