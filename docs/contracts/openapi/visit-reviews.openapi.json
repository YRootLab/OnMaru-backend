        "additionalProperties": false,
        "properties": {
          "schemaVersion": { "type": "string", "const": "1.2" },
          "regionRevision": { "type": "string" },
          "countsAsOf": { "type": "string", "format": "date-time" },
          "parentRegionCode": { "type": ["string", "null"] },
          "unassignedCount": { "type": "integer", "minimum": 0 },
          "items": { "type": "array", "maxItems": 300, "items": { "$ref": "#/components/schemas/RegionCount" } }
        },
        "required": ["schemaVersion", "regionRevision", "countsAsOf", "parentRegionCode", "unassignedCount", "items"]
      },
      "RegionCount": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "regionCode": { "type": "string" },
          "parentRegionCode": { "type": ["string", "null"] },
          "name": { "type": "string" },
          "level": { "type": "string", "enum": ["SIDO", "SIGUNGU"] },
          "center": { "$ref": "#/components/schemas/Coordinate" },
          "reviewCount": { "type": "integer", "minimum": 0 },
          "coverageStatus": { "type": "string", "enum": ["SUPPORTED", "UNSUPPORTED"] },
          "hasChildren": { "type": "boolean" }
        },
        "required": ["regionCode", "parentRegionCode", "name", "level", "center", "reviewCount", "coverageStatus", "hasChildren"]
      },
      "RegionResolution": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "schemaVersion": { "type": "string", "const": "1.2" },
          "regionRevision": { "type": "string" },
          "candidates": { "type": "array", "maxItems": 5, "items": { "$ref": "#/components/schemas/RegionCandidate" } }
        },
        "required": ["schemaVersion", "regionRevision", "candidates"]
      },
      "RegionCandidate": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "regionCode": { "type": "string" },
          "parentRegionCode": { "type": ["string", "null"] },
          "name": { "type": "string" }
        },
        "required": ["regionCode", "parentRegionCode", "name"]
      },
      "Coordinate": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "lat": { "type": "number", "minimum": -90, "maximum": 90 },
          "lng": { "type": "number", "minimum": -180, "maximum": 180 }
        },
        "required": ["lat", "lng"]
      },
      "VisitReview": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "placeId": {
            "type": "string"
          },
          "placeName": {
            "type": "string"
          },
          "lat": {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          },
          "lng": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "mine": {
            "type": "boolean"
          },
          "likeCount": {
            "type": "integer",
            "minimum": 0
          },
          "likedByMe": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "placeId",
          "placeName",
          "lat",
          "lng",
          "text",
          "createdAt",
          "mine",
          "likeCount",
          "likedByMe"
        ],
        "additionalProperties": false
      },
      "ReviewPage": {
        "type": "object",
        "properties": {
          "schemaVersion": {
            "type": "string",
            "enum": [
              "1.2"
            ]
          },
          "queryKey": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "$ref": "#/components/schemas/VisitReview"
            }
          },
          "nextCursor": {
            "type": [
              "string",
              "null"
            ]
          },
          "hasMore": {
            "type": "boolean"
          },
          "asOf": {
            "type": "string",
            "format": "date-time"
          },
          "coverage": {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "SUPPORTED",
                  "PARTIAL",
                  "UNSUPPORTED"
                ]
              },
              "regionCodes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "status",
              "regionCodes"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "schemaVersion",
          "queryKey",
          "items",
          "nextCursor",
          "hasMore",
          "asOf",
          "coverage"
        ],
        "additionalProperties": false
      },
      "CreateReview": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300,
            "pattern": "^[^\\n]*(?:\\n[^\\n]*){0,4}$",
            "description": "NFC, trim, CRLF to LF before validation. No blank-only text."
          }
        },
        "required": [
          "text"
        ],
        "additionalProperties": false
      },
      "CreateReviewReport": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "reason": {
            "type": "string",
            "enum": ["SPAM", "ABUSE", "PERSONAL_DATA", "COPYRIGHT", "OTHER"]
          },
          "detail": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "required": ["reason"]
      },
      "ReviewReportReceipt": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "schemaVersion": { "type": "string", "const": "1.2" },
          "reportId": { "type": "string" },
          "status": { "type": "string", "enum": ["OPEN", "RESOLVED", "DISMISSED"] }
        },
        "required": ["schemaVersion", "reportId", "status"]
      },
      "LikeState": {
        "type": "object",
        "properties": {
          "likedByMe": {
            "type": "boolean"
          },
          "likeCount": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "likedByMe",
          "likeCount"
        ],
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-onmaru-session"
      }
    }
  }
}
